rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catalogue: public to read, never writable from the client.
    // Products are managed from the Firebase console / admin SDK.
    match /producto/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // A user document (including its cart) belongs to exactly one account.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Anything not matched above is denied.
    // The previous ruleset was `allow read, write: if true` on /{document=**},
    // which let any visitor read every user record and overwrite the catalogue.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
